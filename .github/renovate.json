{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>reactiveui/.github:renovate"
    ],
    "packageRules": [
        {
            "description": "Keep the coverage package pinned until its regression is resolved.",
            "matchManagers": [
                "nuget"
            ],
            "matchPackageNames": [
                "Microsoft.Testing.Extensions.CodeCoverage"
            ],
            "enabled": false
        }
    ]
}
